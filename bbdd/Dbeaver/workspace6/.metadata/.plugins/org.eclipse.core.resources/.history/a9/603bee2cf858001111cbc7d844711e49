DELIMITER $$

DROP TRIGGER IF EXISTS bd_tenda_BI $$
CREATE TRIGGER bd_tenda_BU $$insert
BEFORE INSERT
ON clientes FOR EACH ROW
BEGIN
	SET clt_vendas = clt_ventas+1;
	SET clt_ultima_venda = NOW();
END


DROP TRIGGER IF EXISTS bd_tenda_AD $$
CREATE TRIGGER bd_tenda_AD $$insert
AFTER DELETE
ON clientes FOR EACH ROW
BEGIN
	SET clt_vendas = clt_ventas-1;
	SET clt_ultima_venda = clt_ultima_venda.OLD;
END

DELIMITER ;










